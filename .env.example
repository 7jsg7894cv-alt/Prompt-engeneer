# Configuration de l'API Prompt Maître
# Copier ce fichier en .env et personnaliser les valeurs

# Port du serveur
PORT=8000

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS - Origines autorisées (séparées par des virgules)
# En production, remplacer * par vos domaines autorisés
ALLOWED_ORIGINS=https://make.com,https://your-app.bubble.io,https://your-domain.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Longueur maximale du texte d'entrée (en caractères)
MAX_INPUT_LENGTH=5000

# API Keys (pour futures extensions avec LLMs)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Database (optionnel, pour historique des prompts)
# DATABASE_URL=postgresql://user:password@localhost:5432/promptdb

# Monitoring (optionnel)
# SENTRY_DSN=https://...
# PROMETHEUS_PORT=9090

# Feature flags
ENABLE_BATCH_ENDPOINT=true
ENABLE_ANALYTICS=false
